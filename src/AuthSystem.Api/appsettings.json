{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=authsystem.db"
  },
  "Jwt": {
    "Algorithm": "RS256",
    "AcceptLegacyHs256": true,
    "Issuer": "AuthSystem",
    "Audience": "AuthSystem.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "MfaChallengeMinutes": 5
  }
}
